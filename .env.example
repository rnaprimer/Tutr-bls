# Tutr Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Server-Side Webhook & Service Role Secrets (Never expose to client)
GOOGLE_FORMS_WEBHOOK_SECRET=your-webhook-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Forms Intake Configuration
NEXT_PUBLIC_TUTOR_APPLICATION_FORM_URL=https://docs.google.com/forms/d/e/.../viewform

# Razorpay Configuration (Server-side)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
TUTR_CONNECTION_FEE_INR=99
TUTR_TUTOR_ONBOARDING_FEE_INR=149
